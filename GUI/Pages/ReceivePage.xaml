<Page xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Receive">

    <Page.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="../Styles/Colors.xaml" />
                <ResourceDictionary Source="../Styles/Typography.xaml" />
                <ResourceDictionary Source="../Styles/Controls.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Page.Resources>

    <Grid Background="#F5F0E6" Margin="48,24">
        <StackPanel>
            <TextBlock x:Name="txtReceiveTitle" Text="Receive from another PC"
                       Style="{StaticResource SubtitleText}" Margin="0,0,0,4" />
            <TextBlock Text="On your old PC, open Win11Migrator, choose Export, and pick 'Another PC on this network'. Select this PC and type the code below."
                       Style="{StaticResource BodyText}" Foreground="{StaticResource TextSecondaryBrush}"
                       TextWrapping="Wrap" Margin="0,0,0,24" />

            <Border Style="{StaticResource CardPanel}" Padding="24" Margin="0,0,0,24">
                <StackPanel HorizontalAlignment="Center">
                    <TextBlock Text="Pairing code" Style="{StaticResource CaptionText}" HorizontalAlignment="Center" />
                    <TextBlock x:Name="txtPairingCode" Text="...." FontFamily="Consolas" FontSize="44" FontWeight="Bold"
                               HorizontalAlignment="Center" Foreground="{StaticResource PrimaryBrush}" Margin="0,4,0,8" />
                    <TextBlock x:Name="txtReceiverIdentity" Text="" Style="{StaticResource BodyText}"
                               HorizontalAlignment="Center" TextAlignment="Center" />
                </StackPanel>
            </Border>

            <TextBlock x:Name="txtReceiveStatus" Text="Preparing this PC to receive..."
                       Style="{StaticResource BodyText}" Margin="0,0,0,8" TextWrapping="Wrap" />
            <ProgressBar x:Name="progressReceive" Style="{StaticResource MigratorProgressBar}"
                         Value="0" Maximum="100" Margin="0,0,0,8" />
            <TextBlock x:Name="txtReceiveRate" Text="" Style="{StaticResource CaptionText}"
                       Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4" />
            <TextBlock x:Name="txtReceiveApps" Text="" Style="{StaticResource CaptionText}"
                       Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" />
        </StackPanel>
    </Grid>
</Page>
